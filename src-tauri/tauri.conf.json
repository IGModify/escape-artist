{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Escape Artist",
  "version": "0.3.0",
  "identifier": "app.tarkovhelper.desktop",
  "build": {
    "frontendDist": "../out/web",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://assets.tarkov.dev https://static.wikia.nocookie.net; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../build/snapshot/": "snapshot/"
    },
    "shortDescription": "Tarkov quest overlay",
    "longDescription": "Shows your active Escape from Tarkov quests per map with objective markers, what to bring, PMC spawns and the shortest route from your spawn.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyQ0FGMjk5QzE3REMwN0IKUldSN3dIM0JtZkxLVXRrMXJ6WU85MmIyVlcrcUY5eUJPNDJQNnRmSld1aEFHdWZleVh1dE5IdEsK",
      "endpoints": [
        "https://github.com/IGModify/escape-artist/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
