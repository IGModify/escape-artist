{
  "name": "escape-artist",
  "version": "0.2.0",
  "private": true,
  "description": "Escape from Tarkov companion: active quests per map, objective markers, loadout checklist and an optimal route from your spawn. Runs as a transparent overlay or a normal window.",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --config vite.config.mts",
    "build:web": "vite build --config vite.config.mts",
    "snapshot": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/snapshot.mjs",
    "dist": "npm run snapshot && tauri build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run && cargo test --manifest-path src-tauri/Cargo.toml",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.6",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "leaflet": "1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^5.9.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-http": "2.9.0",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.14.1"
  }
}
